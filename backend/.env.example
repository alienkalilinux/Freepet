# ─────────────────────────────────────────────────────────────
# ФРИПЕТ — пример переменных окружения бэкенда
# Скопируйте файл в backend/.env и заполните реальными значениями.
# Значения по умолчанию подходят только для локальной разработки.
# ─────────────────────────────────────────────────────────────

# База данных: SQLite для разработки или PostgreSQL в рабочей среде
DATABASE_URL=sqlite+aiosqlite:///./frpet.db

# Публичные адреса
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
BACKEND_URL=http://localhost:8000

# Секрет для подписи JWT — ОБЯЗАТЕЛЬНО замените в рабочей среде
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Загрузка файлов
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
# ALLOWED_EXTENSIONS=["jpg","jpeg","png","gif","webp"]

# Почта: Brevo имеет приоритет, затем Gmail SMTP
BREVO_API_KEY=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=ФРИПЕТ <noreply@example.com>

# SMS.ru — если не задан, код выводится в консоль (демо-режим)
SMS_API_KEY=

# Вход через Mail.ru
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=
MAILRU_REDIRECT_URI=http://localhost:8000/api/auth/mailru/callback

# Администратор — смените пароль перед публикацией
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# Тестовый аккаунт — отключите или смените пароль в рабочей среде
TEST_USERNAME=testuser
TEST_PASSWORD=change-me
TEST_EMAIL=test@example.com
