# ─────────────────────────────────────────────────────────────
# ФРИПЕТ — пример переменных окружения фронтенда
# Скопируйте файл в .env.local и заполните реальными значениями.
# Не коммитьте .env.local в репозиторий.
# ─────────────────────────────────────────────────────────────

# Публичный адрес сайта (используется в метаданных, письмах и юридических текстах)
NEXT_PUBLIC_SITE_URL=https://fripet.kz

# ── Реквизиты оператора ──────────────────────────────────────
# Пока значения не заданы, на странице /legal/requisites честно
# показывается «не указано». Не выдумывайте данные.
# Полное наименование (например: ИП Иванов Иван Иванович)
NEXT_PUBLIC_LEGAL_OPERATOR=
# Организационно-правовая форма (ИП, ТОО, АО и т. п.)
NEXT_PUBLIC_LEGAL_FORM=
# БИН или ИИН
NEXT_PUBLIC_LEGAL_BIN=
# Юридический/фактический адрес
NEXT_PUBLIC_LEGAL_ADDRESS=
# Телефон для официальных обращений (необязательно)
NEXT_PUBLIC_LEGAL_PHONE=
# Юрисдикция (по умолчанию Республика Казахстан)
NEXT_PUBLIC_LEGAL_JURISDICTION=Республика Казахстан

# ── Контакты ─────────────────────────────────────────────────
# Общие вопросы и официальные обращения
NEXT_PUBLIC_LEGAL_EMAIL=fripet.kz@gmail.com
# Запросы по персональным данным (доступ, исправление, удаление)
NEXT_PUBLIC_PRIVACY_EMAIL=fripet.kz@gmail.com
# Поддержка и жалобы
NEXT_PUBLIC_SUPPORT_EMAIL=fripet.kz@gmail.com

# ── Карты ────────────────────────────────────────────────────
# Ключ JavaScript API Яндекс.Карт. Если не задан, карта не загружается,
# но город можно выбрать вручную. Карта подключается только после
# согласия пользователя на внешние сервисы.
NEXT_PUBLIC_YANDEX_MAPS_KEY=
